# ------------------------------------------------------------------
# Taurus AI — Environment Variables (Prompt 001 foundation)
# Copy this file to `.env.local` and fill in values for local dev.
# NEVER commit real secrets. `.env*` files are gitignored.
# ------------------------------------------------------------------

# Application
# One of: development | test | production
NODE_ENV=development
# Public base URL of the app (used for links/redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL, pgvector-ready). Not connected in Prompt 001.
# Example: postgresql://user:password@localhost:5432/taurus
DATABASE_URL=

# Auth (Supabase or Clerk-compatible). Placeholder in Prompt 001.
AUTH_SECRET=

# AI provider key — SERVER ONLY. Must never be exposed to the browser.
# Placeholder in Prompt 001 (no provider calls yet).
AI_PROVIDER_API_KEY=
