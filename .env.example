# ------------------------------------------------------------------
# Taurus AI — Environment Variables
# Copy this file to `.env.local` and fill in values for local dev.
# NEVER commit real secrets. `.env*` files are gitignored.
# ------------------------------------------------------------------

# Application
# One of: development | test | production
NODE_ENV=development
# Public base URL of the app (used for links/redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication -----------------------------------------------------
# Secret used to sign session cookies. REQUIRED for sign-in to work.
# Must be at least 16 characters and is mandatory in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# The local dev auth flow is passwordless (email only) and is a stand-in for a
# real provider (Supabase). It is blocked in production unless you set this to
# "true". Leave empty for local development.
TAURUS_ALLOW_DEV_AUTH=

# Supabase Auth (Sprint 012) — production authentication.
# The URL + anon key are PUBLIC (safe for the browser). When both are set the
# app uses Supabase Auth (email+password, email OTP/magic link, Google,
# LinkedIn). When unset, the app falls back to the dev auth flow (local only).
# In production these are REQUIRED unless TAURUS_ALLOW_DEV_AUTH=true.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never exposed to the browser and NOT required
# for the auth flows in this sprint. Leave empty unless a privileged server task
# needs it; if set, keep it strictly server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Database -----------------------------------------------------------
# PostgreSQL connection string (pgvector-ready).
# If LEFT EMPTY, the app uses an in-memory store (local dev / tests only).
# If SET, run migrations with `npm run db:migrate` before starting.
# Example: postgresql://user:password@localhost:5432/taurus
DATABASE_URL=

# AI provider --------------------------------------------------------
# AI provider key — SERVER ONLY. Must never be exposed to the browser.
# Not used yet (no provider calls in the current phase).
AI_PROVIDER_API_KEY=

# Knowledge Vault (Prompt 006) ---------------------------------------
# Local directory for uploaded files (SERVER ONLY). Defaults to
# `storage/uploads` (gitignored). Files are never served publicly.
TAURUS_UPLOAD_DIR=

# Object storage for uploads (Sprint 046, SERVER ONLY). When TAURUS_S3_BUCKET +
# AWS credentials are set, uploaded files persist to S3 (or an S3-compatible
# endpoint) instead of ephemeral local disk — required for serverless/multi-node
# deploys. All optional; absence falls back to local storage. Objects are private
# (never public-read) and served through the same authenticated download route.
TAURUS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: temporary-credential session token (STS / IAM roles).
AWS_SESSION_TOKEN=
# Optional: S3-compatible endpoint host (no scheme), e.g. Cloudflare R2 / MinIO.
TAURUS_S3_ENDPOINT=
# Optional: use path-style URLs (bucket in path) — most MinIO setups need this.
TAURUS_S3_FORCE_PATH_STYLE=
# Optional: key prefix so multiple apps can share one bucket.
TAURUS_S3_PREFIX=

# Model Hub (Prompt 006B) --------------------------------------------
# Provider API keys — SERVER ONLY. All optional. When a key is present, that
# provider can be offered as "Taurus managed". Absent keys never break dev/tests.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
FIREWORKS_API_KEY=

# Master key to encrypt bring-your-own-key provider credentials at rest.
# If empty, BYOK is disabled in the UI (Taurus-managed keys still work).
# Must be at least 16 characters. Generate one with:  openssl rand -base64 32
# Also encrypts data-connector secrets (DB connection strings, Google refresh
# tokens). If empty, those connectors are disabled.
TAURUS_MODEL_CREDENTIALS_MASTER_KEY=

# Knowledge connectors — Google Drive (Sprint 023) ------------------
# OAuth client for the read-only Google Drive connector. Create a "Web
# application" OAuth client in Google Cloud and enable the Google Drive API.
# See docs/connectors/google-drive.md for the full setup. When empty, the
# Google Drive tab is hidden; all other knowledge sources still work.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Optional. If unset, the redirect URI is derived from the request origin as
# <app-origin>/api/knowledge/connectors/google-drive/callback. Set this only if
# you need to pin an exact URI (it must match one registered on the OAuth client).
GOOGLE_DRIVE_REDIRECT_URI=

# Knowledge connectors — SharePoint / OneDrive (Sprint 027) ---------
# Azure AD (Microsoft Entra) app registration for the read-only SharePoint /
# OneDrive connector (Microsoft Graph). Delegated scopes: offline_access,
# User.Read, Files.Read.All, Sites.Read.All. See docs/connectors/sharepoint.md.
# When empty, the SharePoint / OneDrive tab is hidden; other sources still work.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional. Default "common" (work + personal accounts). Set to your Directory
# (tenant) ID or "organizations" for a single-tenant app.
MICROSOFT_TENANT=
# Optional. Pin an exact redirect URI; else derived from the request origin as
# <app-origin>/api/knowledge/connectors/sharepoint/callback.
MICROSOFT_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Billing, Plans & Subscriptions (Prompt 011). ALL server-only — never expose
# these as NEXT_PUBLIC_*. Absent keys => simulated billing (no charges, no
# network): local dev and tests are fully usable without any Stripe setup.
# ---------------------------------------------------------------------------
# Present => live Stripe billing. Absent => simulated mode.
STRIPE_SECRET_KEY=
# Verifies incoming webhook signatures when set (recommended in production).
STRIPE_WEBHOOK_SECRET=
# Stripe Price ids for each paid tier (from your Stripe dashboard).
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ---------------------------------------------------------------------------
# Marketplace paid lease / revenue-share (Sprint 034). ALL server-only. When
# neither Stripe nor Razorpay is configured, marketplace purchases run in
# simulated mode (no charges, no network). Stripe reuses STRIPE_SECRET_KEY /
# STRIPE_WEBHOOK_SECRET above for the hosted Checkout.
# ---------------------------------------------------------------------------
# Present => buyers can pay via Razorpay Payment Links. Absent => Razorpay hidden.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Verifies incoming Razorpay webhook signatures when set (recommended in prod).
RAZORPAY_WEBHOOK_SECRET=
# Platform revenue-share cut in basis points (default 1500 = 15%).
MARKETPLACE_PLATFORM_FEE_BPS=
# Seller payouts (Sprint 035) reuse the same provider keys above: Stripe payouts
# use Stripe Connect (the STRIPE_SECRET_KEY account must have Connect enabled);
# Razorpay payouts use Razorpay Route. With no keys, payouts run in simulated
# mode (accounts activate instantly, withdrawals settle in-process, no money moves).

# ---------------------------------------------------------------------------
# Usage & Margin (Sprint 016). ALL server-only — never NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
# Comma-separated allowlist of platform-OPERATOR user ids that may view Taurus's
# cross-tenant cost/margin at /operator/margin. This is NOT an org role and is
# never assignable from the tenant UI. Absent => nobody is an operator.
PLATFORM_OPERATOR_USER_IDS=
# Optional operator-tunable managed sell price per interaction (displayed only in
# Sprint 016; metered overage charging arrives in Sprint 017). Defaults apply.
MANAGED_INTERACTION_PRICE_USD=
MANAGED_INTERACTION_PRICE_BUDGET_USD=
# Optional: share of plan price above which a MANAGED tenant is "margin at risk"
# (default 0.33 — the floor of the 3× markup band).
MARGIN_AT_RISK_COST_SHARE=
