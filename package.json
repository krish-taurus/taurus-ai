{
  "name": "taurus-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Taurus AI — the world's easiest enterprise AI employee platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:seed": "node scripts/migrate.mjs --seed",
    "db:seed:marketplace": "npx tsx scripts/seed-marketplace.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "framer-motion": "^11.18.2",
    "mammoth": "^1.8.0",
    "mysql2": "^3.22.6",
    "next": "14.2.5",
    "pdf-parse": "^1.1.1",
    "pg": "8.12.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "16.0.0",
    "@types/node": "20.14.12",
    "@types/pg": "8.11.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "eslint-config-prettier": "9.1.0",
    "jsdom": "24.1.1",
    "postcss": "8.4.40",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
